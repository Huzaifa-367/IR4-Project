[Unit]
Description=IR4 Lerd stack (DNS, nginx, PHP-FPM, MySQL, Redis)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=__IR4_USER__
Group=__IR4_GROUP__
WorkingDirectory=__IR4_APP_ROOT__
Environment=HOME=__IR4_HOME__
Environment=XDG_RUNTIME_DIR=__IR4_XDG_RUNTIME_DIR__
Environment=PATH=__IR4_HOME__/.local/share/lerd/bin:__IR4_HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash -lc 'command -v lerd >/dev/null && lerd start'
ExecStop=/bin/bash -lc 'command -v lerd >/dev/null && lerd stop'
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
