[Unit]
Description=IR4 MediaMTX camera gateway (live wall)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__IR4_APP_ROOT__
ExecStart=/bin/bash __IR4_APP_ROOT__/scripts/03-ensure-mediamtx.sh
ExecStop=/usr/bin/docker stop ir4-mediamtx

[Install]
WantedBy=multi-user.target
