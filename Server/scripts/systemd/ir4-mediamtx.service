[Unit]
Description=IR4 MediaMTX camera gateway (live wall)
After=network-online.target
Wants=network-online.target
# Do NOT Requires=docker.service — SCC hosts often have only Podman (Lerd).
# Optional ordering if Docker/Podman units exist:
After=docker.service docker.socket podman.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__IR4_APP_ROOT__
ExecStart=/bin/bash __IR4_APP_ROOT__/scripts/03-ensure-mediamtx.sh
ExecStop=/bin/bash -lc 'docker stop ir4-mediamtx 2>/dev/null || podman stop ir4-mediamtx 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
