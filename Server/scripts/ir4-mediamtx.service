[Unit]
Description=IR4 MediaMTX camera gateway (live wall)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Flattened SCC app root (directory that contains artisan + scripts/)
WorkingDirectory=/data2/laravel/IR4-Project
ExecStart=/bin/bash /data2/laravel/IR4-Project/scripts/ensure-mediamtx.sh
ExecStop=/usr/bin/docker stop ir4-mediamtx

[Install]
WantedBy=multi-user.target
