              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "X-Device-Token",
                    "value": "{{deviceToken}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"events\": [\n    {\n      \"event_uid\": \"{{eventUid}}\",\n      \"camera_ref\": \"{{cameraRef}}\",\n      \"roi_reference\": \"{{roiReference}}\",\n      \"event_type\": \"roi_intrusion\",\n      \"detected_at\": \"{{detectedAt}}\",\n      \"confidence\": 0.91,\n      \"snapshot\": null\n    }\n  ]\n}"
                },
                "url": "{{baseUrl}}/api/ingest/roi-violations",
                "description": "Camera ROI intrusion detections (DOC-23). Same DOC-08 / DOC-10 envelope as PPE.\n\n`event_type`: `roi_intrusion` only (v1).\n\nRequired: `event_uid`, `camera_ref`, `roi_reference`, `event_type`, `detected_at`, `confidence` (0–1).\nOptional: `snapshot` (raw base64 JPEG — identical store path as PPE via shared `IngestSnapshotStore`).\n\nCamera resolved by `camera_ref` (same `ReferenceResolver` as PPE). `roi_reference` must match an enabled ROI on that camera’s **active** published set (else `UNKNOWN_ROI`). Raises `roi_violation` alert (DOC-07) unless backfill."
              }
            },
