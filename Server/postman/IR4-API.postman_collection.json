                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"events\": [\n    {\n      \"event_uid\": \"{{eventUid}}\",\n      \"camera_ref\": \"{{cameraRef}}\",\n      \"event_type\": \"missing_helmet\",\n      \"detected_at\": \"{{detectedAt}}\",\n      \"worker_count\": 1,\n      \"confidence\": 0.92,\n      \"snapshot\": null\n    }\n  ]\n}"
                },
                "url": "{{baseUrl}}/api/ingest/ppe-violations",
                "description": "Single ingest endpoint for PPE + fall detections (DOC-10 / DOC-14).\n\n`event_type`: `missing_helmet` | `missing_vest` | `missing_harness` | `missing_mask` | `fall`\n\nRequired: `event_uid`, `camera_ref`, `event_type`, `detected_at`, `confidence` (0–1).\nOptional: `worker_count`, `snapshot` (raw base64 JPEG string — same store as ROI: private `snapshots/Y/m/d/{uuid}.jpg`). For `fall`, omit `worker_count`."
              }
            },
            {
              "name": "POST /api/ingest/roi-violations",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {",
                      "  const r = Math.random() * 16 | 0;",
                      "  return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);",
                      "});",
                      "pm.variables.set('eventUid', uuid());",
                      "pm.variables.set('detectedAt', new Date().toISOString());"
                    ]
