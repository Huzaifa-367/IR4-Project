        {
          "name": "Ingest",
          "item": [
            {
              "name": "POST /api/ingest/tag-readings",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {",
                      "  const r = Math.random() * 16 | 0;",
                      "  return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);",
                      "});",
                      "pm.variables.set('eventUid', uuid());",
                      "pm.variables.set('recordedAt', new Date().toISOString());"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "X-Device-Token",
                    "value": "{{deviceToken}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"events\": [\n    {\n      \"event_uid\": \"{{eventUid}}\",\n      \"reader_ref\": \"{{readerRef}}\",\n      \"tag_uid\": \"{{tagUid}}\",\n      \"recorded_at\": \"{{recordedAt}}\",\n      \"rssi\": -26,\n      \"antenna\": 1\n    }\n  ]\n}"
                },
                "url": "{{baseUrl}}/api/ingest/tag-readings",
                "description": "RFID tag reads (DOC-09).\n\nPer event: `event_uid`, `reader_ref`, `tag_uid`, `recorded_at`, optional `rssi` (peakRssi) and `antenna`.\nUnknown EPCs are auto-registered as in_stock. FXR90 does not report tag distance.\n`reader_ref` must resolve to a registered device/reader reference."
              }
            },
            {
              "name": "POST /api/ingest/headcount-readings",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {",
                      "  const r = Math.random() * 16 | 0;",
                      "  return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);",
                      "});",
                      "pm.variables.set('eventUid', uuid());",
                      "pm.variables.set('recordedAt', new Date().toISOString());"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "X-Device-Token",
                    "value": "{{deviceToken}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"events\": [\n    {\n      \"event_uid\": \"{{eventUid}}\",\n      \"recorded_at\": \"{{recordedAt}}\",\n      \"count\": {{headcountCount}},\n      \"camera_ref\": \"{{cameraRef}}\"\n    }\n  ]\n}"
                },
                "url": "{{baseUrl}}/api/ingest/headcount-readings",
                "description": "Absolute camera FOV / zone headcount samples (DOC-09).\n\nCaller must be `edge_compute` (`X-Device-Token`).\n\nPer event: `event_uid`, `recorded_at`, `count` (≥0), `camera_ref`.\n`zone_id` is snapped from time-aware `camera_zone_bindings` at `recorded_at` (unbound → null zone; excluded from live totals).\nBoth RFID and camera paths keep writing; `tracking.headcount_source` picks live Total Manpower.\n\nLocal mimic: `php scripts/mimic_headcount_edge.php` (optional `--loop`)."
              }
            },
