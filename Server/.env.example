BACKUP_ARCHIVE_PASSWORD=
MYSQL_DUMP_BINARY_PATH=/usr/bin
MYSQL_DUMP_TIMEOUT=3600
DISK_SPACE_WARN_PCT=15

MAIL_ENCRYPTION=null
