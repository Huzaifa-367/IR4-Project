APP_NAME=IR4
APP_ENV=local
APP_KEY=base64:QCzLK4rGIwAWK54sHByFGI9w0FpnVZl1sbLgyI1cqJw=
APP_DEBUG=true
APP_URL=https://ir4-project.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Riyadh

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=lerd-mysql
DB_PORT=3306
DB_DATABASE=ir4_project
DB_USERNAME=root
DB_PASSWORD=lerd

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Must match how you browse: false for http://…:9100, true for https://ir4-project.test
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Prefer file on shared hosting (Hostinger) to avoid a ballooning `cache` table.
# Hourly ir4:prune-expired-cache still deletes expired DB cache rows when using database.
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=lerd-redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=lerd-mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=618732
REVERB_APP_KEY=bh2sf2ixciz7kx5q0jn3
REVERB_APP_SECRET=5hemnyoneoswpknrcwpc
# Where the Reverb process binds (must be reachable from Lerd PHP, not only the SCC browser).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Laravel → Reverb HTTP API (inside Lerd). Do not point this at a workstation hostname.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Browser Echo uses the page origin (see resources/js/lib/reverb-client.ts).
# VITE_REVERB_HOST must never be 127.0.0.1/localhost — that is the SCC, not operator PCs.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=ir4-project.test
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Browser-safe camera gateway (MediaMTX). Live wall uses hls.js → /hls/{reference}/.
# Permanent contract: same-origin /hls proxy (do NOT point at :8888 in the browser).
# On SCC run: bash scripts/ensure-mediamtx-env.sh  (sets LAN IP + warm TCP RTSP).
# {reference} = Camera.reference from the dashboard.
CAMERA_BROWSER_STREAM_URL_TEMPLATE=/hls/{reference}/
# MediaMTX control API — when set, saving a camera RTSP URL auto-registers the path.
# Under Lerd/Podman use the SCC LAN IP (pasta gateway 10.89.x.x is NOT the host):
#   MEDIAMTX_API_URL=http://192.168.x.x:9997
# Or run: bash scripts/ensure-mediamtx-env.sh
MEDIAMTX_API_URL=gateway
MEDIAMTX_HOST_IP=
# Optional; defaults to API host on :8888 (used by same-origin /hls proxy).
MEDIAMTX_HLS_URL=
# MediaMTX API basic auth only — leave empty if api auth is disabled (not camera RTSP user/pass).
MEDIAMTX_API_USER=
MEDIAMTX_API_PASS=
# Keep RTSP warm for live wall (false). true = connect only when a viewer opens the path.
MEDIAMTX_SOURCE_ON_DEMAND=false
MEDIAMTX_RTSP_TRANSPORT=tcp

# Equipment ZT411 printer (deploy config — DOC-18/20). Not runtime settings.
EQUIPMENT_PRINTER_HOST=
EQUIPMENT_PRINTER_PORT=9100

# Spatie site backup (DOC-19/20). On-prem alerts via AlertService — no mail.
# Mount BACKUP_DISK_ROOT into the PHP runtime; mysqldump must be on PATH.
BACKUP_DISK_ROOT=/data/ir4-backups
BACKUP_ARCHIVE_PASSWORD=
MYSQL_DUMP_BINARY_PATH=/usr/bin
MYSQL_DUMP_TIMEOUT=3600
DISK_SPACE_WARN_PCT=15

MAIL_ENCRYPTION=null
