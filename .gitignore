.DS_Store
.idea/
.fleet/
.nova/
.zed/
.phpactor.json

# Local IDE (tracked selectively under .vscode/)
# Keep .vscode/* committed; ignore user-specific clutter if added later.

# Secrets / local TLS at either root or Server/
.env
.env.backup
.env.production
**/.env
**/auto.crt
**/auto.key

# Laravel / Node artifacts (Server/)
Server/vendor/
Server/node_modules/
Server/bootstrap/ssr/
Server/public/build/
Server/public/hot/
Server/public/storage/
Server/public/fonts-manifest.dev.json
Server/storage/*.key
Server/storage/pail/
Server/.phpunit.cache/
Server/.phpunit.result.cache
Server/resources/js/actions/
Server/resources/js/routes/
Server/resources/js/wayfinder/
Server/auth.json
Server/npm-debug.log
Server/yarn-error.log

# EdgeCompute local artifacts
EdgeCompute/configs/secrets.local.env
EdgeCompute/var/
EdgeCompute/.venv/
EdgeCompute/**/__pycache__/

# Flutter
Mobile/.dart_tool/
Mobile/build/
Mobile/.flutter-plugins-dependencies
Mobile/.packages

# Encoded SCC release tree (rebuild: php Server/scripts/build-encoded-release.php)
# Keep Release/README.md tracked; ignore generated payload.
Release/server/
Release/MANIFEST.sha256

/linkedin_posts