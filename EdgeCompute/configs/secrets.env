# IR4 edge secrets — edit tokens after issuing them on the SCC.
# Loaded automatically by agents (and by systemd EnvironmentFile).
# Prefer secrets.local.env for machine-specific overrides (gitignored).
#
# Orin agents → Lerd LAN HTTP (no DNS/TLS needed).
# Browsers → https://ir4-project.test (dnsmasq *.test → 192.168.3.149)

IR4_BASE_URL=http://192.168.3.149:9100

# Gas detector (type gas_detector)
IR4_GAS_DEVICE_TOKEN=
IR4_GAS_DEVICE_UUID=

# RFID reader (type rfid_reader)
IR4_RFID_DEVICE_TOKEN=
IR4_RFID_DEVICE_UUID=

# Mosquitto (RFID agent ↔ broker)
IR4_MQTT_USERNAME=ir4-rfid
IR4_MQTT_PASSWORD=

# IR4_DRY_RUN=1
