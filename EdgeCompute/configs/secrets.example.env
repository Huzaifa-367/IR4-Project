# Copy to secrets.env and fill in. secrets.env is gitignored.
#   cp configs/secrets.example.env configs/secrets.env
#   # or: ir4-edge setup

# Shared
IR4_BASE_URL=https://ir4.ispc-ai.com

# Gas — set UUID/token for THIS pole (DEV-GAS-01 … DEV-GAS-04)
IR4_GAS_DEVICE_TOKEN=
IR4_GAS_DEVICE_UUID=

# RFID — set UUID/token for THIS pole (DEV-RFID-01 … DEV-RFID-04)
IR4_RFID_DEVICE_TOKEN=
IR4_RFID_DEVICE_UUID=

# Mosquitto (local Orin broker)
# USE_AUTH=0 → agent connects anonymously; passwords still stored for FXR90 / later lock-down
IR4_MQTT_USE_AUTH=0
IR4_MQTT_USERNAME=ir4-rfid
IR4_MQTT_PASSWORD=
IR4_MQTT_FXR90_PASSWORD=

# IR4_DRY_RUN=1
