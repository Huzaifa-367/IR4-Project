[Unit]
Description=IR4 YT-98H gas ingest agent
Documentation=file:///opt/ir4-edge/EdgeCompute/docs/runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ir4edge
Group=dialout
WorkingDirectory=/opt/ir4-edge/EdgeCompute
EnvironmentFile=-/opt/ir4-edge/EdgeCompute/configs/secrets.env
EnvironmentFile=-/opt/ir4-edge/EdgeCompute/configs/secrets.local.env
ExecStart=/opt/ir4-edge/venv/bin/ir4-gas-agent
Restart=on-failure
RestartSec=5
# Keep the agent below the 5-minute DOC-05 stale window even after brief crashes.
WatchdogSec=0

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ir4-gas-agent

# Harden slightly: no new privileges; secrets via EnvironmentFile only.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
